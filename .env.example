# ---- Server ----
# Railway injects PORT automatically; do not set it there.
PORT=4100
NODE_ENV=development

# ---- Database (required) ----
# Atlas → Network Access must allow Railway's egress. 0.0.0.0/0 is the usual
# choice for a hosted app, since Railway's outbound IPs are not static.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prohelper?appName=PROHELPER

# ---- Auth (required) ----
JWT_SECRET=replace_with_a_long_random_string
JWT_TTL=30d

# Demo auth: any 6-digit OTP is accepted (numbers are still stored).
# Set to false in production to enforce real OTP verification.
DUMMY_AUTH=true
DEV_OTP=true

# ---- Cloudinary (required for document & photo uploads) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Admin bootstrap (web dashboard login) ----
ADMIN_EMAIL=admin@prohelper.in
ADMIN_PASSWORD=change_me
