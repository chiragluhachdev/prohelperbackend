# ---- Server ----
PORT=4100
NODE_ENV=development

# ---- Database ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prohelper?appName=PROHELPER

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_string
JWT_TTL=30d

# OTP is returned in the API response + logged so the MVP can be demoed
# without an SMS provider. MUST be false in production.
DEV_OTP=true

# Demo auth: any 6-digit OTP is accepted (numbers are still stored).
# Set to false to enforce real OTP verification.
DUMMY_AUTH=true

# ---- Cloudinary (Aadhaar documents & profile photos) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Admin bootstrap (web dashboard login) ----
ADMIN_EMAIL=admin@prohelper.in
ADMIN_PASSWORD=admin@123
